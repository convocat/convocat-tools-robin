# Copy this file to .env and fill in your own keys. Never share .env or put it on GitHub.

# Robin needs two model services, because Claude has no embeddings model.
# Claude writes the answers and runs the guardrails:
# (https://platform.claude.com -> API keys. A Claude Pro or Max subscription is NOT an API key:
#  the API is billed separately, so set a spending limit on the account.)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI, used only to turn text into embeddings for the look-up (RAG), a few cents at most
# (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Langfuse: Settings > API Keys in your Langfuse project
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional settings (these are the defaults)
ROBIN_MODEL=claude-sonnet-5-5
COMPARE_MODEL=claude-haiku-5-5
GUARDRAIL_MODEL=claude-haiku-5-5
GUARDRAIL_EFFORT=low
MAX_MESSAGES_PER_CHAT=40
LANGFUSE_TRACING_ENVIRONMENT=course

# Set a passcode so only course participants can use Robin (and your OpenAI budget)
COURSE_PASSCODE=
